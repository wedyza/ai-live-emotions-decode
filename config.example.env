# Optional overrides. Reliable mode is the default.
AI_EMOTION_MODEL=reliable
AI_RELIABILITY_PATH=models/emotion_reliable
CV_RABBIT__PREFETCH_COUNT=1
# Experimental comparison: AI_EMOTION_MODEL=experimental and AI_EMOTION_MODEL_PATH=models/emotion_experiment/model.onnx
# cv-service saves face crops to S3 (<frame_id>_f<i>.png); the mode must match the model's "crop".
# reliable/variant1/aligned: yunet5_similarity_v1; experimental/pretrained: bbox without margin or alignment
# CV_SAVE_CROPS=true
# CV_FACE_CROP=yunet5_similarity_v1

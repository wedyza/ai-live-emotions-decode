# Optional. Defaults work with the bundled model and local docker-compose.yaml.
# Copy to .env only if you need overrides. Never commit .env.
AI_EMOTION_MODEL=experimental
AI_EMOTION_MODEL_PATH=models/emotion_experiment/model.onnx
CV_RABBIT__PREFETCH_COUNT=1
# To compare with the original model, change AI_EMOTION_MODEL to pretrained.
# Original weights are downloaded on first use and need Internet.
